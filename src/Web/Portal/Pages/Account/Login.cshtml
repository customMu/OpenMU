@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}
<h1>Login</h1>
<form method="post" class="form">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Input.LoginName">Login name</label>
    <input asp-for="Input.LoginName" autocomplete="username" />

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" autocomplete="current-password" />

    <input type="hidden" asp-for="ReturnUrl" />
    <button type="submit">Login</button>
</form>
<p>No account yet? <a asp-page="/Account/Register">Register</a></p>
