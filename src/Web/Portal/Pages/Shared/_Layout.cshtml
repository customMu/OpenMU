@using Microsoft.Extensions.Options
@inject IOptions<PortalOptions> Options
@{
    var serverName = Options.Value.ServerName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is { } title ? $"{title} - {serverName}" : serverName)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <a class="brand" asp-page="/Index">@serverName</a>
    <nav>
        <a asp-page="/Index">Home</a>
        <a asp-page="/Rankings/Characters">Characters</a>
        <a asp-page="/Rankings/Guilds">Guilds</a>
        <a asp-page="/Download">Download</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Account/Index">@User.Identity.Name</a>
            <form method="post" asp-page="/Account/Logout" class="inline">
                <button type="submit" class="link">Logout</button>
            </form>
        }
        else
        {
            <a asp-page="/Account/Login">Login</a>
            <a asp-page="/Account/Register" class="button">Register</a>
        }
    </nav>
</header>
<main class="container">
    @RenderBody()
</main>
<footer class="site-footer">
    @serverName &middot; powered by <a href="https://github.com/MUnique/OpenMU">OpenMU</a>
</footer>
</body>
</html>
