@page
@using Microsoft.Extensions.Options
@inject IOptions<PortalOptions> Options
@{
    ViewData["Title"] = "Download";
}
<h1>Download</h1>
@if (Options.Value.Downloads.Count == 0)
{
    <p class="muted">No downloads available yet.</p>
}
else
{
    <ul class="downloads">
        @foreach (var download in Options.Value.Downloads)
        {
            <li>
                <a href="@download.Url" class="button">@download.Title</a>
                @if (!string.IsNullOrEmpty(download.Size))
                {
                    <span class="muted">@download.Size</span>
                }
            </li>
        }
    </ul>
}
